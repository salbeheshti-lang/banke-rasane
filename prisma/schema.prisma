// Prisma schema — NOT USED in production.
// The actual database is managed by mini-services/api-service (bun:sqlite).
// This file is kept for reference only.
// To use Prisma with the actual schema, replace with the real models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}
