# Copy this file to .env for local development.
# Use a unique, randomly generated password (12+ characters) for the first admin.
ADMIN_INITIAL_PASSWORD=replace-with-a-unique-random-password-at-least-12-chars

# Prisma's local SQLite connection; set this to a path that exists on your machine.
DATABASE_URL=file:./dev.db

# Optional CORS allowlist for the local API (comma-separated exact origins).
# When unset, wildcard CORS remains for backward compatibility; set this in deployments.
# BANKRESANE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
