# Next.js / Prisma
DATABASE_URL="file:./db/custom.db"

# Local Bun API service
DB_PATH="./mini-services/api-service/bankresaneh.sqlite"
CORS_ORIGINS="http://127.0.0.1:3000"

# Local API bind address (default: 127.0.0.1). Only use a non-loopback host
# when intentionally deploying the API behind a trusted reverse proxy.
BANKRESANEH_HOST=127.0.0.1

# Required for non-loopback/server deployments. Use a unique strong password
# of at least 12 characters; never commit the actual secret.
BANKRESANEH_ADMIN_PASSWORD=
