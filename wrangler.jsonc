{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bankresaneh-visual-preview",
  "main": ".open-next/worker.js",
  "account_id": "b6778c6e8515d363eb8b06e3c653b4c9",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "BANKRESANEH_API_BASE": "https://bankresaneh-preview-api.onrender.com"
  }
}
